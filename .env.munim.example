# MunimAI Integration Environment Variables

# Groq API (for LLM and Whisper)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# OpenAI (for Whisper fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Twilio (for WhatsApp, SMS, Voice)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Tavily (for scheme search)
TAVILY_API_KEY=your_tavily_api_key_here

# Sarvam AI (for Hindi TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Socket.IO
SOCKETIO_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Feature Flags
MUNIM_MOCK_MODE=true
MUNIM_SEED_DEMO_DATA=true
